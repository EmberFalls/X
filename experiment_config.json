{
  "project": {
    "name": "SimuTrade",
    "version": "2.0",
    "paper_target": "IEEE Student Conference / IJCRT",
    "thesis": "Bridging the Gap in Retail Quantitative Finance: A Heuristic NLP-to-Parameters Mapping System for Algorithmic Trading"
  },

  "evaluation_protocol": {
    "log_dir": "logs",
    "output_dir": "outputs",

    "start_date": "2023-01-01",
    "end_date": "2024-12-31",
    "default_interval": "1d",
    "exchange": "NSE",

    "methods": [
      "heuristic_fallback",
      "llm"
    ],

    "benchmark_prompt_file": "benchmark_prompts.json",
    "benchmark_ticker_file": "benchmark_tickers.json"
  },

  "execution_defaults": {
    "initial_capital": 100000,
    "risk_percent": 2.0,
    "slippage_pct": 0.1,
    "transaction_cost_pct": 0.05,
    "atr_period": 14
  },

  "nse_basket": [
    "RELIANCE.NS",
    "TCS.NS",
    "INFY.NS",
    "HDFCBANK.NS",
    "ICICIBANK.NS",
    "HINDUNILVR.NS",
    "ITC.NS",
    "SBIN.NS",
    "BAJFINANCE.NS",
    "KOTAKBANK.NS"
  ],

  "strategy_registry": [
    "golden_cross",
    "mean_reversion",
    "rsi_strategy",
    "macd_crossover",
    "momentum_breakout"
  ],

  "benchmark_prompts": [
    {
      "id": "P01",
      "prompt": "safe trend-following strategy for large cap stocks",
      "expected_strategy": "golden_cross",
      "expected_risk_profile": "low",
      "difficulty": "easy",
      "category": "trend"
    },
    {
      "id": "P02",
      "prompt": "buy the dip on Infosys using bollinger bands",
      "expected_strategy": "mean_reversion",
      "expected_risk_profile": "medium",
      "difficulty": "easy",
      "category": "mean_reversion"
    },
    {
      "id": "P03",
      "prompt": "RSI oversold bounce strategy with tight stop loss",
      "expected_strategy": "rsi_strategy",
      "expected_risk_profile": "low",
      "difficulty": "easy",
      "category": "reversal"
    },
    {
      "id": "P04",
      "prompt": "MACD crossover with momentum confirmation on TCS",
      "expected_strategy": "macd_crossover",
      "expected_risk_profile": "medium",
      "difficulty": "medium",
      "category": "momentum"
    },
    {
      "id": "P05",
      "prompt": "aggressive breakout strategy for high volatility stocks",
      "expected_strategy": "momentum_breakout",
      "expected_risk_profile": "high",
      "difficulty": "easy",
      "category": "breakout"
    },
    {
      "id": "P06",
      "prompt": "I want to trade Reliance with moderate risk using moving average crossover",
      "expected_strategy": "golden_cross",
      "expected_risk_profile": "medium",
      "difficulty": "medium",
      "category": "trend"
    },
    {
      "id": "P07",
      "prompt": "sideways market mean reversion play on HDFC Bank with wider bands",
      "expected_strategy": "mean_reversion",
      "expected_risk_profile": "medium",
      "difficulty": "medium",
      "category": "mean_reversion"
    },
    {
      "id": "P08",
      "prompt": "something safe for beginners that follows the trend",
      "expected_strategy": "golden_cross",
      "expected_risk_profile": "low",
      "difficulty": "hard",
      "category": "trend"
    },
    {
      "id": "P09",
      "prompt": "scalp high momentum breakouts on BAJFINANCE intraday",
      "expected_strategy": "momentum_breakout",
      "expected_risk_profile": "high",
      "difficulty": "medium",
      "category": "breakout"
    },
    {
      "id": "P10",
      "prompt": "overbought overbought sell signal with RSI 70 on ITC",
      "expected_strategy": "rsi_strategy",
      "expected_risk_profile": "medium",
      "difficulty": "hard",
      "category": "reversal"
    }
  ],

  "benchmark_tickers": [
    "RELIANCE.NS",
    "TCS.NS",
    "INFY.NS",
    "HDFCBANK.NS",
    "ICICIBANK.NS"
  ],

  "technical_eval": {
    "valid_output_rate_target": 0.90,
    "backtest_completion_rate_target": 0.85,
    "max_acceptable_latency_ms": 5000
  },

  "trading_eval": {
    "benchmark_index": "^NSEI",
    "min_trades_per_run": 3,
    "metrics": [
      "totalReturn",
      "sharpeRatio",
      "maxDrawdown",
      "winRate",
      "totalTrades",
      "finalValue",
      "buyHoldValue"
    ]
  },

  "usability_eval": {
    "flows": ["manual", "heuristic_fallback", "llm"],
    "metrics": [
      "time_to_submit_sec",
      "form_errors",
      "apply_button_used",
      "backtest_triggered"
    ]
  }
}