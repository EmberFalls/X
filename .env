# SimuTrade secret and runtime configuration
# Replace only the placeholder value for GROQ_API_KEY.

GROQ_API_KEY=your_groq_api_key_here
SIMUTRADE_LOG_DIR=logs
SIMUTRADE_OUTPUT_DIR=outputs
SIMUTRADE_SESSION_ID=research-local-session
SIMUTRADE_DEFAULT_INTERVAL=1d
SIMUTRADE_DEFAULT_EXCHANGE=NSE
SIMUTRADE_DEFAULT_INITIAL_CAPITAL=100000
SIMUTRADE_DEFAULT_RISK_PERCENT=2.0
SIMUTRADE_DEFAULT_SLIPPAGE_PCT=0.1
SIMUTRADE_DEFAULT_TRANSACTION_COST_PCT=0.05